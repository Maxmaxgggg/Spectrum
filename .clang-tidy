# Проверка имён по правилам из NAMING.md. Только она: остальные проверки
# clang-tidy здесь не настроены.
#
# qcustomplot.* — сторонняя библиотека, её имена не наши; заголовок
# исключён фильтром ниже, а qcustomplot.cpp в анализ не отправлять.
Checks: '-*,readability-identifier-naming'
HeaderFilterRegex: '(compute|storage|tests|ui)[/\\]|(constants|settings|types)\.h'
CheckOptions:
  # Типы и пространства имён
  readability-identifier-naming.NamespaceCase: CamelCase
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  # quint64 в .cuh повторяет тип Qt для nvcc, который заголовков Qt не видит
  readability-identifier-naming.TypedefIgnoredRegexp: '^quint64$'
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypeTemplateParameterCase: CamelCase
  readability-identifier-naming.ValueTemplateParameterCase: UPPER_CASE

  # Функции; в тестах эталонные коды названы по параметрам: hamming7_4
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.FunctionIgnoredRegexp: '^[a-z][A-Za-z]*[0-9]+_[0-9]+$'
  readability-identifier-naming.MethodCase: camelBack

  # Переменные; приставки памяти CUDA: d_ — устройство, h_ — копия на
  # хосте, s_ — разделяемая, c_ — константная
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.ParameterIgnoredRegexp: '^[hd]_[a-z][A-Za-z0-9]*$'
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.LocalVariableIgnoredRegexp: '^[hds]_[a-z][A-Za-z0-9]*$'
  readability-identifier-naming.StaticVariableCase: camelBack
  readability-identifier-naming.StaticVariableIgnoredRegexp: '^s_[a-z][A-Za-z0-9]*$'
  readability-identifier-naming.GlobalVariableCase: camelBack
  readability-identifier-naming.GlobalVariablePrefix: g_
  readability-identifier-naming.GlobalVariableIgnoredRegexp: '^c_[a-z][A-Za-z0-9]*$'
  readability-identifier-naming.PublicMemberCase: camelBack
  readability-identifier-naming.PublicMemberIgnoredRegexp: '^[hd]_[a-z][A-Za-z0-9]*$'
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberPrefix: m_

  # Константы и макросы
  readability-identifier-naming.ConstexprVariableCase: UPPER_CASE
  readability-identifier-naming.GlobalConstantCase: UPPER_CASE
  readability-identifier-naming.StaticConstantCase: UPPER_CASE
  readability-identifier-naming.ClassConstantCase: UPPER_CASE
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
